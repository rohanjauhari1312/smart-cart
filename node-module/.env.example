# Anthropic — same key used elsewhere in Nourish
ANTHROPIC_API_KEY=

# Kroger Developer Portal: https://developer.kroger.com
# Register an app to get these. Client-credentials creds below are enough
# for product search (read-only). Cart-write needs a separate authorization-code
# flow — see README.md.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional — a Kroger store location ID. Without one, product search still
# works but prices may not be returned for every candidate (Kroger ties
# pricing to a specific store). Find one via GET /v1/locations.
KROGER_LOCATION_ID=
# Only needed for the cart-write OAuth authorization-code flow (see README.md).
# Must match a redirect URI registered on your Kroger developer app.
KROGER_REDIRECT_URI=http://localhost:3000/kroger/callback

# USDA FoodData Central: https://fdc.nal.usda.gov/api-key-signup.html
# Free, self-serve, instant signup — used as a fallback/cross-check when
# Open Food Facts data is sparse for a product.
USDA_API_KEY=

# Supabase — same project as the rest of Nourish
SUPABASE_URL=https://lciduukaracpqhjmgkiu.supabase.co
SUPABASE_KEY=

# Free-delivery minimum in USD. THIS IS A PLACEHOLDER — confirm against the
# actual retailer/store policy before relying on it for real orders.
FREE_DELIVERY_MINIMUM_USD=35
